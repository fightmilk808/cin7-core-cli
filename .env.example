# Cin7 Core API credentials. Never commit real values.
# Either the raw values, or a 1Password reference resolved with `op read`.
CIN7_ACCOUNT_ID=op://<vault>/<item>/account-id
CIN7_APP_KEY=op://<vault>/<item>/application-key
# Optional
# CIN7_RATE_PER_MIN=40
# CIN7_BASE_URL=https://inventory.dearsystems.com/ExternalApi/v2
